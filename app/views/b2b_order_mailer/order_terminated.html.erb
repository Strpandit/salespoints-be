<% if @view_type == "buyer" %>
  <!-- ========== BUYER VIEW ========== -->
  <div style="background:#F3F6FB;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#111827;line-height:1.6;">
    <div style="max-width:700px;margin:0 auto;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,0.06);">
      
      <div style="background:linear-gradient(135deg,#DC2626,#991B1B);padding:32px 40px;color:#FFFFFF;">
        <div style="font-size:13px;letter-spacing:3px;text-transform:uppercase;opacity:0.8;font-weight:600;">SalesPoints B2B</div>
        <h1 style="margin:8px 0 4px;font-size:26px;font-weight:700;line-height:1.2;">❌ Request <%= @reason %></h1>
        <p style="margin:4px 0 0;font-size:16px;opacity:0.9;">Request #<%= @order.reference_number %></p>
      </div>
      
      <div style="padding:32px 40px;">
        <p style="font-size:16px;color:#1E293B;">Hello <strong><%= @buyer&.full_name || @buyer&.dealer_code || 'Dealer' %></strong>,</p>
        <p style="font-size:15px;color:#334155;">Your B2B request <strong style="color:#DC2626;"><%= @order.reference_number %></strong> has been <strong><%= @reason.downcase %></strong>.</p>
        
        <div style="background:#FEF2F2;border:1px solid #FCA5A5;border-radius:10px;padding:16px 20px;margin:18px 0;">
          <table style="width:100%;border-collapse:collapse;font-size:14px;">
            <tr><td style="padding:4px 0;color:#64748B;width:140px;">Request Number</td><td style="padding:4px 0;font-weight:600;color:#DC2626;"><%= @order.reference_number %></td></tr>
            <tr><td style="padding:4px 0;color:#64748B;">Total Amount</td><td style="padding:4px 0;font-weight:600;">₹<%= @order.total_amount.to_f.round(2) %></td></tr>
            <tr><td style="padding:4px 0;color:#64748B;">Status</td><td style="padding:4px 0;font-weight:600;color:#DC2626;"><%= @reason %></td></tr>
          </table>
        </div>
        
        <div style="margin-top:20px;padding:14px 18px;background:#FEFCE8;border:1px solid #FDE68A;border-radius:8px;font-size:14px;color:#92400E;">
          💡 You can create a new request anytime from your SalesPoints dashboard.
        </div>
      </div>
    </div>
  </div>

<% elsif @view_type == "admin" %>
  <!-- ========== ADMIN VIEW ========== -->
  <div style="background:#F3F6FB;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#111827;line-height:1.6;">
    <div style="max-width:700px;margin:0 auto;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,0.06);">
      
      <div style="background:linear-gradient(135deg,#DC2626,#991B1B);padding:28px 40px;color:#FFFFFF;">
        <div style="font-size:13px;letter-spacing:3px;text-transform:uppercase;opacity:0.8;font-weight:600;">Admin Alert</div>
        <h1 style="margin:8px 0 4px;font-size:24px;font-weight:700;">❌ Request <%= @reason %></h1>
        <p style="margin:4px 0 0;font-size:16px;opacity:0.9;">Request #<%= @order.reference_number %></p>
      </div>
      
      <div style="padding:28px 40px;">
        <div style="background:#F8FAFC;border-left:4px solid #DC2626;border-radius:8px;padding:12px 16px;margin-bottom:12px;">
          <h3 style="margin:0 0 4px;font-size:13px;font-weight:700;color:#DC2626;text-transform:uppercase;letter-spacing:0.5px;">Buyer</h3>
          <p style="margin:2px 0;font-size:14px;"><%= @buyer&.full_name || @buyer&.dealer_code || 'N/A' %></p>
          <p style="margin:2px 0;font-size:13px;color:#64748B;"><%= @buyer&.email || 'N/A' %> | <%= @buyer&.phone || 'N/A' %></p>
        </div>
        
        <h3 style="margin:14px 0 8px;font-size:13px;font-weight:700;color:#DC2626;text-transform:uppercase;letter-spacing:0.5px;">Order Items</h3>
        <% @order.b2b_order_items.each do |item| %>
          <div style="border:1px solid #E5E7EB;border-radius:6px;padding:6px 12px;margin-bottom:4px;display:flex;justify-content:space-between;font-size:13px;background:#FFFFFF;">
            <span><%= item.product_variant&.product&.name || 'Product' %> × <%= item.quantity %></span>
            <span style="font-weight:600;">₹<%= item.total_price.to_f.round(2) %></span>
          </div>
        <% end %>
        
        <div style="border-top:2px solid #E5E7EB;padding-top:12px;margin-top:10px;text-align:right;">
          <div style="font-size:20px;font-weight:700;color:#DC2626;">Total: ₹<%= @order.total_amount.to_f.round(2) %></div>
          <div style="font-size:13px;color:#DC2626;font-weight:600;">Status: <%= @reason %></div>
        </div>
      </div>
    </div>
  </div>
<% end %>