<% if @view_type == "buyer" %>
  <!-- ========== BUYER VIEW ========== -->
  <div style="background:#F3F6FB;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#111827;line-height:1.6;">
    <div style="max-width:700px;margin:0 auto;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,0.06);">
      
      <div style="background:linear-gradient(135deg,#15803D,#0F766E);padding:32px 40px;color:#FFFFFF;">
        <div style="font-size:13px;letter-spacing:3px;text-transform:uppercase;opacity:0.8;font-weight:600;">SalesPoints B2B</div>
        <h1 style="margin:8px 0 4px;font-size:26px;font-weight:700;line-height:1.2;">✅ Order Confirmed</h1>
        <p style="margin:4px 0 0;font-size:16px;opacity:0.9;">Order #<%= @order.reference_number %></p>
      </div>
      
      <div style="padding:32px 40px;">
        <p style="font-size:16px;color:#1E293B;">Hello <strong><%= @buyer&.full_name || @buyer&.dealer_code || 'Dealer' %></strong>,</p>
        <p style="font-size:15px;color:#334155;">Your B2B order <strong style="color:#0F766E;"><%= @order.reference_number %></strong> has been confirmed.</p>
        <p style="font-size:15px;color:#334155;">Your order will be processed and shipped within <strong>48 hours</strong>.</p>
        
        <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;padding:16px 20px;margin:20px 0;">
          <table style="width:100%;border-collapse:collapse;font-size:14px;">
            <tr><td style="padding:4px 0;color:#64748B;width:140px;">Order Number</td><td style="padding:4px 0;font-weight:600;color:#0F766E;"><%= @order.reference_number %></td></tr>
            <tr><td style="padding:4px 0;color:#64748B;">Total Amount</td><td style="padding:4px 0;font-weight:600;">₹<%= @order.total_amount.to_f.round(2) %></td></tr>
            <tr><td style="padding:4px 0;color:#64748B;">Payment Method</td><td style="padding:4px 0;"><%= payment_method_label(@order.payment_method) %></td></tr>
            <tr><td style="padding:4px 0;color:#64748B;">Payment Status</td><td style="padding:4px 0;font-weight:600;color:#15803D;">✅ <%= @order.payment_status.to_s.upcase %></td></tr>
          </table>
        </div>
        
        <h3 style="margin:18px 0 12px;font-size:14px;font-weight:700;color:#0F766E;text-transform:uppercase;letter-spacing:0.5px;">Order Items</h3>
        <% @order.b2b_order_items.each do |item| %>
          <div style="border:1px solid #E5E7EB;border-radius:8px;padding:10px 14px;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;font-size:14px;background:#FFFFFF;">
            <div>
              <strong><%= item.product_variant&.product&.name || 'Product' %></strong>
              <span style="color:#64748B;font-size:13px;margin-left:8px;">× <%= item.quantity %></span>
            </div>
            <span style="font-weight:600;color:#0F766E;">₹<%= item.total_price.to_f.round(2) %></span>
          </div>
        <% end %>
        
        <div style="border-top:2px solid #E5E7EB;padding-top:14px;margin-top:12px;text-align:right;">
          <div style="font-size:20px;font-weight:700;color:#0F766E;">Total: ₹<%= @order.total_amount.to_f.round(2) %></div>
        </div>
        
        <div style="margin-top:20px;padding:14px 18px;background:#ECFDF5;border:1px solid #A7F3D0;border-radius:8px;font-size:14px;color:#065F46;">
          🚚 You'll receive shipping confirmation once the order is dispatched.
        </div>
      </div>
    </div>
  </div>

<% elsif @view_type == "seller" %>
  <!-- ========== SELLER VIEW ========== -->
  <div style="background:#F3F6FB;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#111827;line-height:1.6;">
    <div style="max-width:700px;margin:0 auto;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,0.06);">
      
      <div style="background:linear-gradient(135deg,#059669,#0F766E);padding:28px 40px;color:#FFFFFF;">
        <div style="font-size:13px;letter-spacing:3px;text-transform:uppercase;opacity:0.8;font-weight:600;">SalesPoints B2B</div>
        <h1 style="margin:8px 0 4px;font-size:24px;font-weight:700;">✅ Order Confirmed</h1>
        <p style="margin:4px 0 0;font-size:16px;opacity:0.9;">Order #<%= @order.reference_number %></p>
      </div>
      
      <div style="padding:28px 40px;">
        <p style="font-size:16px;color:#1E293B;">Hello <strong><%= @seller&.full_name || @seller&.dealer_code || 'Seller' %></strong>,</p>
        <p style="font-size:15px;color:#334155;">Order <strong style="color:#0F766E;"><%= @order.reference_number %></strong> has been confirmed.</p>
        
        <div style="background:#F8FAFC;border-left:4px solid #059669;border-radius:8px;padding:14px 18px;margin:16px 0;">
          <h3 style="margin:0 0 8px;font-size:13px;font-weight:700;color:#059669;text-transform:uppercase;letter-spacing:0.5px;">Buyer Information</h3>
          <table style="width:100%;border-collapse:collapse;font-size:14px;">
            <tr><td style="padding:3px 0;color:#64748B;width:110px;">Dealer Code</td><td style="padding:3px 0;font-weight:500;"><%= @buyer&.dealer_code || 'N/A' %></td></tr>
            <tr><td style="padding:3px 0;color:#64748B;">Phone</td><td style="padding:3px 0;font-weight:500;"><%= @buyer&.phone || 'N/A' %></td></tr>
            <tr><td style="padding:3px 0;color:#64748B;">Address</td><td style="padding:3px 0;font-weight:500;"><%= @buyer&.dealer_profile&.business_address || 'N/A' %></td></tr>
          </table>
        </div>
        
        <div style="background:#F8FAFC;border:1px solid #E2E8F0;border-radius:8px;padding:12px 16px;">
          <table style="width:100%;border-collapse:collapse;font-size:14px;">
            <tr><td style="padding:3px 0;color:#64748B;width:130px;">Order Number</td><td style="padding:3px 0;font-weight:600;"><%= @order.reference_number %></td></tr>
            <tr><td style="padding:3px 0;color:#64748B;">Total</td><td style="padding:3px 0;font-weight:600;">₹<%= @order.total_amount.to_f.round(2) %></td></tr>
            <tr><td style="padding:3px 0;color:#64748B;">Payment Method</td><td style="padding:3px 0;"><%= payment_method_label(@order.payment_method) %></td></tr>
          </table>
        </div>
        
        <div style="margin-top:16px;padding:14px 18px;background:#FEF3C7;border:1px solid #FCD34D;border-radius:8px;font-size:14px;color:#92400E;">
          📦 <strong>Action Required:</strong> Please dispatch this order within <strong>48 hours</strong>.
        </div>
      </div>
    </div>
  </div>

<% elsif @view_type == "admin" %>
  <!-- ========== ADMIN VIEW ========== -->
  <div style="background:#F3F6FB;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#111827;line-height:1.6;">
    <div style="max-width:700px;margin:0 auto;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,0.06);">
      
      <div style="background:linear-gradient(135deg,#15803D,#0F766E);padding:28px 40px;color:#FFFFFF;">
        <div style="font-size:13px;letter-spacing:3px;text-transform:uppercase;opacity:0.8;font-weight:600;">Admin Alert</div>
        <h1 style="margin:8px 0 4px;font-size:24px;font-weight:700;">✅ Order Confirmed</h1>
        <p style="margin:4px 0 0;font-size:16px;opacity:0.9;">Order #<%= @order.reference_number %></p>
      </div>
      
      <div style="padding:28px 40px;">
        <div style="background:#F8FAFC;border-left:4px solid #0F766E;border-radius:8px;padding:12px 16px;margin-bottom:10px;">
          <h3 style="margin:0 0 4px;font-size:13px;font-weight:700;color:#0F766E;text-transform:uppercase;letter-spacing:0.5px;">Buyer</h3>
          <p style="margin:2px 0;font-size:14px;"><%= @buyer&.full_name || @buyer&.dealer_code || 'N/A' %></p>
          <p style="margin:2px 0;font-size:13px;color:#64748B;"><%= @buyer&.email || 'N/A' %> | <%= @buyer&.phone || 'N/A' %></p>
          <p style="margin:2px 0;font-size:13px;color:#64748B;">Address: <%= @buyer&.dealer_profile&.business_address || 'N/A' %></p>
        </div>
        
        <div style="background:#F8FAFC;border-left:4px solid #059669;border-radius:8px;padding:12px 16px;margin-bottom:10px;">
          <h3 style="margin:0 0 4px;font-size:13px;font-weight:700;color:#059669;text-transform:uppercase;letter-spacing:0.5px;">Seller</h3>
          <p style="margin:2px 0;font-size:14px;"><%= @seller&.full_name || @seller&.dealer_code || 'N/A' %></p>
          <p style="margin:2px 0;font-size:13px;color:#64748B;"><%= @seller&.email || 'N/A' %> | <%= @seller&.phone || 'N/A' %></p>
          <p style="margin:2px 0;font-size:13px;color:#64748B;">Address: <%= @seller&.dealer_profile&.business_address || 'N/A' %></p>
        </div>
        
        <h3 style="margin:14px 0 8px;font-size:13px;font-weight:700;color:#0F766E;text-transform:uppercase;letter-spacing:0.5px;">Order Items</h3>
        <% @order.b2b_order_items.each do |item| %>
          <div style="border:1px solid #E5E7EB;border-radius:6px;padding:6px 12px;margin-bottom:4px;display:flex;justify-content:space-between;font-size:13px;background:#FFFFFF;">
            <span><%= item.product_variant&.product&.name || 'Product' %> × <%= item.quantity %></span>
            <span style="font-weight:600;">₹<%= item.total_price.to_f.round(2) %></span>
          </div>
        <% end %>
        
        <div style="border-top:2px solid #E5E7EB;padding-top:12px;margin-top:10px;text-align:right;">
          <div style="font-size:13px;color:#64748B;">Subtotal: ₹<%= @order.subtotal_amount.to_f.round(2) %></div>
          <div style="font-size:13px;color:#64748B;">Tax: ₹<%= @order.tax_amount.to_f.round(2) %></div>
          <div style="font-size:20px;font-weight:700;color:#0F766E;">Total: ₹<%= @order.total_amount.to_f.round(2) %></div>
          <div style="font-size:13px;color:#15803D;font-weight:600;">Payment: <%= payment_method_label(@order.payment_method) %> ✅</div>
        </div>
      </div>
    </div>
  </div>
<% end %>