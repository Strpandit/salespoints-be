<div style="background:#F3F6FB;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#111827;line-height:1.6;">
  <div style="max-width:700px;margin:0 auto;background:#FFFFFF;border:1px solid #E5E7EB;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,0.06);">
    
    <!-- Header -->
    <div style="background:linear-gradient(135deg,#1E40AF,#0F766E);padding:32px 40px;color:#FFFFFF;">
      <div style="font-size:13px;letter-spacing:3px;text-transform:uppercase;opacity:0.8;font-weight:600;">SalesPoints B2B</div>
      <h1 style="margin:8px 0 4px;font-size:26px;font-weight:700;line-height:1.2;">🔔 New B2B Request</h1>
      <p style="margin:4px 0 0;font-size:16px;opacity:0.9;">Request #<%= @order.reference_number %></p>
      <p style="margin:4px 0 0;font-size:13px;opacity:0.7;">Placed on <%= format_date(@order.created_at) %></p>
    </div>
    
    <!-- Body -->
    <div style="padding:32px 40px;">
      
      <!-- Buyer Information -->
      <div style="background:#F8FAFC;border-left:4px solid #0F766E;border-radius:8px;padding:18px 20px;margin-bottom:20px;">
        <h3 style="margin:0 0 12px;font-size:14px;font-weight:700;color:#0F766E;text-transform:uppercase;letter-spacing:0.5px;">Buyer Information</h3>
        <table style="width:100%;border-collapse:collapse;font-size:14px;">
          <tr><td style="padding:3px 0;color:#64748B;width:120px;">Name</td><td style="padding:3px 0;font-weight:500;"><%= @buyer&.full_name || @buyer&.dealer_code || 'N/A' %></td></tr>
          <tr><td style="padding:3px 0;color:#64748B;">Dealer Code</td><td style="padding:3px 0;font-weight:500;"><%= @buyer&.dealer_code || 'N/A' %></td></tr>
          <tr><td style="padding:3px 0;color:#64748B;">Email</td><td style="padding:3px 0;font-weight:500;"><%= @buyer&.email || 'N/A' %></td></tr>
          <tr><td style="padding:3px 0;color:#64748B;">Phone</td><td style="padding:3px 0;font-weight:500;"><%= @buyer&.phone || 'N/A' %></td></tr>
          <tr><td style="padding:3px 0;color:#64748B;">Address</td><td style="padding:3px 0;font-weight:500;"><%= @buyer&.dealer_profile&.business_address || 'N/A' %></td></tr>
        </table>
      </div>
      
      <!-- Request Items -->
      <h3 style="margin:20px 0 12px;font-size:14px;font-weight:700;color:#0F766E;text-transform:uppercase;letter-spacing:0.5px;">Request Items</h3>
      <% @order.b2b_order_items.each do |item| %>
        <div style="border:1px solid #E5E7EB;border-radius:8px;padding:14px 16px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;background:#FFFFFF;">
          <div>
            <strong style="font-size:14px;"><%= item.product_variant&.product&.name || 'Product' %></strong>
            <div style="font-size:13px;color:#64748B;margin-top:2px;">Qty: <%= item.quantity %></div>
          </div>
          <div style="font-weight:600;font-size:15px;color:#0F766E;">₹<%= item.total_price.to_f.round(2) %></div>
        </div>
      <% end %>
      
      <!-- Totals -->
      <div style="border-top:2px solid #E5E7EB;padding-top:18px;margin-top:16px;text-align:right;">
        <div style="display:flex;justify-content:flex-end;gap:20px;font-size:14px;color:#64748B;">
          <span>Subtotal</span>
          <span style="font-weight:500;">₹<%= @order.subtotal_amount.to_f.round(2) %></span>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:20px;font-size:14px;color:#64748B;margin-top:2px;">
          <span>Tax</span>
          <span style="font-weight:500;">₹<%= @order.tax_amount.to_f.round(2) %></span>
        </div>
        <div style="display:flex;justify-content:flex-end;gap:20px;font-size:20px;font-weight:700;color:#0F766E;margin-top:6px;border-top:1px dashed #E5E7EB;padding-top:10px;">
          <span>Total</span>
          <span>₹<%= @order.total_amount.to_f.round(2) %></span>
        </div>
        <div style="margin-top:8px;font-size:13px;color:#64748B;">
          Status: <span style="font-weight:600;color:#F59E0B;">Pending Acceptance</span>
        </div>
      </div>
      
      <!-- Footer Note -->
      <div style="margin-top:24px;padding-top:16px;border-top:1px solid #E5E7EB;font-size:13px;color:#94A3B8;text-align:center;">
        This is an automated notification from SalesPoints B2B Platform.
      </div>
    </div>
  </div>
</div>