<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      }
      .header {
        background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
        color: white;
        padding: 30px;
        text-align: center;
      }
      .header h2 {
        margin: 0;
        font-size: 24px;
      }
      .content {
        padding: 30px;
      }
      .ticket-info {
        background: #f0f0f0;
        border-radius: 5px;
        padding: 20px;
        margin: 20px 0;
        border-left: 4px solid #ff9800;
      }
      .info-row {
        display: flex;
        justify-content: space-between;
        margin: 10px 0;
        font-size: 14px;
      }
      .label {
        font-weight: bold;
        color: #7f8c8d;
      }
      .footer {
        background: #ecf0f1;
        padding: 20px;
        text-align: center;
        font-size: 12px;
        color: #7f8c8d;
        border-top: 1px solid #bdc3c7;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h2>🎫 Support Ticket Updated</h2>
      </div>

      <div class="content">
        <p>Hi <strong><%= @requester_name %></strong>,</p>

        <p>Your support ticket has been updated. Please review the changes below.</p>

        <div class="ticket-info">
          <div class="info-row">
            <span class="label">Ticket Number:</span>
            <span><strong><%= @ticket.ticket_number %></strong></span>
          </div>
          <div class="info-row">
            <span class="label">Subject:</span>
            <span><%= @ticket.subject %></span>
          </div>
          <div class="info-row">
            <span class="label">Current Status:</span>
            <span><strong><%= @ticket.status.humanize %></strong></span>
          </div>
          <div class="info-row">
            <span class="label">Priority:</span>
            <span><strong><%= @ticket.priority.upcase %></strong></span>
          </div>
        </div>

        <p>For more details, please log into your account and view your ticket.</p>

        <p>Thank you for your patience!<br>
        <strong>SalesPoints Support Team</strong></p>
      </div>

      <div class="footer">
        <p style="margin: 0;">© <%= Date.today.year %> SalesPoints. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
