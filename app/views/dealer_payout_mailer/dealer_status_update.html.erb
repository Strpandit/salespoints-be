<div style="background:#f4f7fb;padding:32px 16px;font-family:Arial,sans-serif;color:#0f172a;">
  <div style="max-width:720px;margin:0 auto;background:#ffffff;border:1px solid #dbe4f0;border-radius:22px;overflow:hidden;box-shadow:0 20px 50px rgba(15,23,42,0.08);">
    <div style="padding:28px 32px;background:linear-gradient(135deg,#0f766e,#1e293b);color:#fff;">
      <div style="font-size:12px;letter-spacing:1.4px;text-transform:uppercase;opacity:0.9;">SalesPoints Payout Desk</div>
      <h1 style="margin:14px 0 8px;font-size:28px;line-height:1.3;">Payout Request Updated</h1>
      <p style="margin:0;font-size:15px;line-height:1.7;max-width:560px;opacity:0.95;">Your payout request has a new status update.</p>
    </div>
    <div style="padding:32px;">
      <p style="margin:0 0 18px;font-size:15px;">Hello <strong><%= @payout.dealer.full_name.presence || "Dealer" %></strong>,</p>
      <p style="margin:0 0 18px;font-size:15px;line-height:1.8;">Request <strong><%= @payout.request_number %></strong> is now <strong><%= @payout.status.to_s.humanize %></strong>.</p>
      <div style="padding:22px;border-radius:16px;background:#f8fafc;border:1px solid #e2e8f0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Amount</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;">Rs <%= format_amount(@payout.amount) %></td></tr>
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Payment Reference</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;"><%= @payout.payment_reference.presence || "Pending" %></td></tr>
          <tr><td style="padding:0;color:#475569;font-size:13px;">Admin Note</td><td style="padding:0;text-align:right;font-size:13px;font-weight:700;"><%= @payout.admin_note.presence || "N/A" %></td></tr>
        </table>
      </div>
    </div>
  </div>
</div>
