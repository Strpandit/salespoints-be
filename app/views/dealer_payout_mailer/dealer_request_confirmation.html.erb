<div style="background:#f4f7fb;padding:32px 16px;font-family:Arial,sans-serif;color:#0f172a;">
  <div style="max-width:720px;margin:0 auto;background:#ffffff;border:1px solid #dbe4f0;border-radius:22px;overflow:hidden;box-shadow:0 20px 50px rgba(15,23,42,0.08);">
    <div style="padding:28px 32px;background:linear-gradient(135deg,#0f766e,#1d4ed8);color:#fff;">
      <div style="font-size:12px;letter-spacing:1.4px;text-transform:uppercase;opacity:0.9;">SalesPoints Payout Desk</div>
      <h1 style="margin:14px 0 8px;font-size:28px;line-height:1.3;">Payout Request Submitted</h1>
      <p style="margin:0;font-size:15px;line-height:1.7;max-width:560px;opacity:0.95;">Your payout request has been logged successfully. Our admin team will review the request and process the transfer through Cashfree.</p>
    </div>

    <div style="padding:32px;">
      <p style="margin:0 0 18px;font-size:15px;line-height:1.8;">Hello <strong><%= @payout.dealer.full_name.presence || "Dealer" %></strong>,</p>

      <div style="padding:22px;border-radius:16px;background:#f8fafc;border:1px solid #e2e8f0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Request Number</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;"><%= @payout.request_number %></td></tr>
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Amount</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;">Rs <%= format_amount(@payout.amount) %></td></tr>
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Status</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;color:#1d4ed8;"><%= @payout.status.to_s.humanize %></td></tr>
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Order Reference</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;"><%= @payout.order_reference.presence || "N/A" %></td></tr>
          <tr><td style="padding:0;color:#475569;font-size:13px;">Invoice Number</td><td style="padding:0;text-align:right;font-size:13px;font-weight:700;"><%= @payout.invoice_number.presence || "N/A" %></td></tr>
        </table>
      </div>

      <div style="margin-top:22px;padding:18px 20px;border-radius:14px;background:#ecfeff;border:1px solid #a5f3fc;">
        <p style="margin:0;font-size:13px;line-height:1.8;color:#155e75;">Your GST invoice has been attached with this email for reference.</p>
      </div>
    </div>
  </div>
</div>
