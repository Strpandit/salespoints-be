<div style="background:#f4f7fb;padding:32px 16px;font-family:Arial,sans-serif;color:#0f172a;">
  <div style="max-width:720px;margin:0 auto;background:#ffffff;border:1px solid #dbe4f0;border-radius:22px;overflow:hidden;box-shadow:0 20px 50px rgba(15,23,42,0.08);">
    <div style="padding:28px 32px;background:linear-gradient(135deg,#1d4ed8,#0f172a);color:#fff;">
      <div style="font-size:12px;letter-spacing:1.4px;text-transform:uppercase;opacity:0.9;">SalesPoints Admin Finance</div>
      <h1 style="margin:14px 0 8px;font-size:28px;line-height:1.3;">Payout Status Changed</h1>
      <p style="margin:0;font-size:15px;line-height:1.7;max-width:560px;opacity:0.95;">Dealer payout request status has been updated.</p>
    </div>
    <div style="padding:32px;">
      <div style="padding:22px;border-radius:16px;background:#f8fafc;border:1px solid #e2e8f0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Dealer</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;"><%= @payout.dealer.full_name.presence || @payout.dealer.dealer_code %></td></tr>
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Request Number</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;"><%= @payout.request_number %></td></tr>
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Status</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;"><%= @payout.status.to_s.humanize %></td></tr>
          <tr><td style="padding:0 0 10px;color:#475569;font-size:13px;">Payment Reference</td><td style="padding:0 0 10px;text-align:right;font-size:13px;font-weight:700;"><%= @payout.payment_reference.presence || "Pending" %></td></tr>
          <tr><td style="padding:0;color:#475569;font-size:13px;">Admin Note</td><td style="padding:0;text-align:right;font-size:13px;font-weight:700;"><%= @payout.admin_note.presence || "N/A" %></td></tr>
        </table>
      </div>
    </div>
  </div>
</div>
