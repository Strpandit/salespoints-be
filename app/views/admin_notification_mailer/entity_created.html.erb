<%= render 'admin_notification_mailer/email_header' %>

      <!-- Card -->
      <div class="card" style="padding:0; overflow:hidden;">

        <!-- Header banner -->
        <div class="header">
          <div class="header-icon">🆕</div>
          <div class="header-text">
            <h1><%= @entity_type %> Created</h1>
            <p>SalesPoints Admin Notification</p>
          </div>
        </div>

        <div style="padding:28px 32px;">

          <!-- Entity badge -->
          <span class="entity-badge" style="background:#eff6ff; color:#1d4ed8;">
            📋 <%= @entity_type %>
          </span>

          <!-- Intro -->
          <p class="intro">
            A new <strong><%= @entity_type %></strong> record named
            <strong>&ldquo;<%= @entity_name %>&rdquo;</strong>
            has been <strong>created</strong> on the SalesPoints platform.
          </p>

          <!-- Who did it -->
          <div class="actor-label">Created By</div>
          <div class="actor-block">
            <div class="actor-avatar">
              <%= (@actor[:name].presence || @actor[:email] || "?")[0] %>
            </div>
            <div class="actor-info">
              <div class="actor-name"><%= @actor[:name].presence || "Unknown" %></div>
              <div class="actor-email"><%= @actor[:email].presence || "—" %></div>
            </div>
          </div>

          <!-- Initial field values (if provided) -->
          <% if @details.present? %>
            <div class="changes-section">
              <div class="section-title">📋 Record Details</div>
              <div class="details-grid">
                <% @details.each do |field, value| %>
                  <div class="detail-row">
                    <div class="detail-key"><%= field.to_s.humanize %></div>
                    <div class="detail-val"><%= value.presence || "—" %></div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Timestamp -->
          <div class="timestamp-strip">
            🕐 <span>Created at:</span>
            <%= Time.current.strftime("%d %b %Y, %I:%M %p %Z") %>
          </div>

          <div class="note-box">
            ✅ This record is now live. Log in to the admin dashboard to review it.
          </div>

          <!-- Footer -->
          <div class="footer">
            <p>This is an automated notification from <strong>SalesPoints</strong>.</p>
            <p style="margin-top:6px;">© 2026 SalesPoints. All rights reserved.</p>
          </div>

        </div>
      </div>
    </div>
  </body>
</html>
