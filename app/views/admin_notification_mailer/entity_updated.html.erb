<%= render 'admin_notification_mailer/email_header' %>

      <!-- Card -->
      <div class="card" style="padding:0; overflow:hidden;">

        <!-- Header banner -->
        <div class="header" style="background: linear-gradient(135deg, #d97706 0%, #b45309 100%);">
          <div class="header-icon">✏️</div>
          <div class="header-text">
            <h1><%= @entity_type %> Updated</h1>
            <p>SalesPoints Admin Notification</p>
          </div>
        </div>

        <div style="padding:28px 32px;">

          <!-- Entity badge -->
          <span class="entity-badge" style="background:#fffbeb; color:#d97706;">
            📋 <%= @entity_type %> — Modified
          </span>

          <!-- Intro -->
          <p class="intro">
            The <strong><%= @entity_type %></strong> record
            <strong>&ldquo;<%= @entity_name %>&rdquo;</strong>
            has been <strong>modified</strong>.
            The following changes were made:
          </p>

          <!-- Who did it -->
          <div class="actor-label">Updated By</div>
          <div class="actor-block" style="background:#fffbeb; border-color:#fde68a;">
            <div class="actor-avatar" style="background:#d97706;">
              <%= (@actor[:name].presence || @actor[:email] || "?")[0] %>
            </div>
            <div class="actor-info">
              <div class="actor-name" style="color:#92400e;"><%= @actor[:name].presence || "Unknown" %></div>
              <div class="actor-email"><%= @actor[:email].presence || "—" %></div>
            </div>
          </div>

          <!-- Before → After changes table -->
          <% if @changes.present? %>
            <div class="changes-section">
              <div class="section-title">🔄 What Changed</div>
              <table class="changes-table">
                <thead>
                  <tr>
                    <th>Field</th>
                    <th>Before</th>
                    <th>After</th>
                  </tr>
                </thead>
                <tbody>
                  <% @changes.each do |field, diff| %>
                    <tr>
                      <td><%= field.to_s.humanize %></td>
                      <td>
                        <span class="val-old">
                          <%= diff[:from].presence || diff["from"].presence || "—" %>
                        </span>
                      </td>
                      <td>
                        <span class="val-new">
                          <%= diff[:to].presence || diff["to"].presence || "—" %>
                        </span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p style="color:#9ca3af; font-size:13px; margin-bottom:16px;">
              No field-level diff was recorded for this update.
            </p>
          <% end %>

          <!-- Timestamp -->
          <div class="timestamp-strip">
            🕐 <span>Updated at:</span>
            <%= Time.current.strftime("%d %b %Y, %I:%M %p %Z") %>
          </div>

          <div class="warning-box">
            ⚠️ Review these changes in the admin dashboard. If this action was unintended, contact your team immediately.
          </div>

          <!-- Footer -->
          <div class="footer">
            <p>This is an automated notification from <strong>SalesPoints</strong>.</p>
            <p style="margin-top:6px;">© 2026 SalesPoints. All rights reserved.</p>
          </div>

        </div>
      </div>
    </div>
  </body>
</html>
