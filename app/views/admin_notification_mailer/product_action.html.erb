<%
  ACTION_COLORS_P = {
    "approved"   => { bg: "#f0fdf4", border: "#bbf7d0", badge_bg: "#16a34a" },
    "rejected"   => { bg: "#fef2f2", border: "#fecaca", badge_bg: "#dc2626" },
    "updated"    => { bg: "#fffbeb", border: "#fde68a", badge_bg: "#d97706" },
    "removed"    => { bg: "#fef2f2", border: "#fecaca", badge_bg: "#dc2626" },
    "added"      => { bg: "#f0fdf4", border: "#bbf7d0", badge_bg: "#16a34a" },
  }.freeze
  palette = ACTION_COLORS_P[@action.to_s.downcase] ||
            { bg: "#fdf4ff", border: "#e9d5ff", badge_bg: "#9333ea" }
%>
<%= render 'admin_notification_mailer/email_header' %>

      <!-- Card -->
      <div class="card" style="padding:0; overflow:hidden;">

        <!-- Header banner -->
        <div class="header" style="background: linear-gradient(135deg, #9333ea 0%, #6b21a8 100%);">
          <div class="header-icon">📦</div>
          <div class="header-text">
            <h1>Product Action: <%= @action.to_s.titleize %></h1>
            <p>SalesPoints Admin Notification</p>
          </div>
        </div>

        <div style="padding:28px 32px;">

          <!-- Badge row -->
          <div style="margin-bottom:20px; display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
            <span class="entity-badge" style="background:#fdf4ff; color:#7e22ce;">
              📦 Dealer Product
            </span>
            <span class="action-badge" style="background:<%= palette[:badge_bg] %>; color:#fff;">
              <%= @action.to_s.upcase %>
            </span>
          </div>

          <!-- Intro -->
          <p class="intro">
            The product <strong>&ldquo;<%= @product_name %>&rdquo;</strong>
            submitted by dealer <strong><%= @dealer_name %></strong>
            has had the action <strong><%= @action.to_s.titleize %></strong> applied to it.
          </p>

          <!-- Dealer info quick-block -->
          <div class="changes-section" style="margin-bottom:16px;">
            <div class="section-title">🏪 Dealer Details</div>
            <div class="details-grid">
              <div class="detail-row">
                <div class="detail-key">Dealer Name</div>
                <div class="detail-val"><%= @dealer_name %></div>
              </div>
              <div class="detail-row">
                <div class="detail-key">Product</div>
                <div class="detail-val"><strong><%= @product_name %></strong></div>
              </div>
            </div>
          </div>

          <!-- Who did it -->
          <div class="actor-label">Action Performed By</div>
          <div class="actor-block" style="background:<%= palette[:bg] %>; border-color:<%= palette[:border] %>;">
            <div class="actor-avatar" style="background:<%= palette[:badge_bg] %>;">
              <%= (@actor[:name].presence || @actor[:email] || "?")[0] %>
            </div>
            <div class="actor-info">
              <div class="actor-name"><%= @actor[:name].presence || "Unknown" %></div>
              <div class="actor-email"><%= @actor[:email].presence || "—" %></div>
            </div>
          </div>

          <!-- Before → After changes -->
          <% if @changes.present? %>
            <div class="changes-section">
              <div class="section-title">🔄 What Changed</div>
              <table class="changes-table">
                <thead>
                  <tr>
                    <th>Field</th>
                    <th>Before</th>
                    <th>After</th>
                  </tr>
                </thead>
                <tbody>
                  <% @changes.each do |field, diff| %>
                    <tr>
                      <td><%= field.to_s.humanize %></td>
                      <td><span class="val-old"><%= diff[:from] || diff["from"] || "—" %></span></td>
                      <td><span class="val-new"><%= diff[:to]   || diff["to"]   || "—" %></span></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>

          <!-- Free-text details -->
          <% if @details.present? %>
            <div class="changes-section">
              <div class="section-title">📝 Additional Notes</div>
              <p style="font-size:14px; color:#374151; line-height:1.6;"><%= @details %></p>
            </div>
          <% end %>

          <!-- Timestamp -->
          <div class="timestamp-strip">
            🕐 <span>Action performed at:</span>
            <%= Time.current.strftime("%d %b %Y, %I:%M %p %Z") %>
          </div>

          <!-- Footer -->
          <div class="footer">
            <p>This is an automated notification from <strong>SalesPoints</strong>.</p>
            <p style="margin-top:6px;">© 2026 SalesPoints. All rights reserved.</p>
          </div>

        </div>
      </div>
    </div>
  </body>
</html>
