<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        margin: 0;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      }
      .header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        text-align: center;
      }
      .header h2 {
        margin: 0;
        font-size: 24px;
      }
      .content {
        padding: 30px;
      }
      .welcome-box {
        background: #f0f0f0;
        border-radius: 5px;
        padding: 20px;
        margin: 20px 0;
        border-left: 4px solid #667eea;
      }
      .next-steps {
        background: #f9f9f9;
        padding: 20px;
        border-radius: 5px;
        margin: 20px 0;
      }
      .step {
        display: flex;
        margin: 10px 0;
      }
      .step-number {
        background: #667eea;
        color: white;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        font-weight: bold;
        flex-shrink: 0;
      }
      .step-text {
        padding-top: 5px;
      }
      .cta-button {
        display: inline-block;
        background: #667eea;
        color: white;
        padding: 12px 30px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
        margin: 20px 0;
      }
      .footer {
        background: #ecf0f1;
        padding: 20px;
        text-align: center;
        font-size: 12px;
        color: #7f8c8d;
        border-top: 1px solid #bdc3c7;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h2>🎉 Welcome to SalesPoints!</h2>
      </div>

      <div class="content">
        <p>Hi <strong><%= @account.first_name.presence || "there" %></strong>,</p>

        <p>Thank you for signing up with SalesPoints! We're excited to have you join our community of shoppers.</p>

        <div class="welcome-box">
          <p style="margin: 0; color: #7f8c8d; font-size: 12px; text-transform: uppercase;">Your Account Created</p>
          <p style="margin: 10px 0 0 0; font-size: 14px;">
            <strong>Email:</strong> <%= @account.email %><br>
            <strong>Status:</strong> Active
          </p>
        </div>

        <div class="next-steps">
          <h3 style="margin: 0 0 15px 0; color: #2c3e50;">What's Next?</h3>
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-text">Complete your profile with additional information</div>
          </div>
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-text">Browse our amazing products and collections</div>
          </div>
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-text">Add items to your wishlist or cart</div>
          </div>
          <div class="step">
            <div class="step-number">4</div>
            <div class="step-text">Complete your first purchase</div>
          </div>
        </div>

        <p>
          <a href="<%= ENV['FRONTEND_URL'] || 'https://salespoints.in' %>" class="cta-button">Start Shopping Now</a>
        </p>

        <p>If you have any questions or need assistance, our support team is here to help.</p>
      </div>

      <div class="footer">
        <p>This is an automated email from SalesPoints.</p>
        <p>© 2026 SalesPoints. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
