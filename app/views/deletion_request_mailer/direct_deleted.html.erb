<%= render layout: "deletion_request_mailer/layout",
locals: { title: "🚫 Account Deleted" } do %>

<p>Your account has been deleted by an administrator.</p>

<div class="info-block">

  <div class="label">Account</div>
  <div class="value"><%= @account.full_name %></div>

  <div class="label" style="margin-top:15px;">Deleted By</div>
  <div class="value"><%= @actor.full_name %></div>

  <div class="label" style="margin-top:15px;">Deleted At</div>
  <div class="value"><%= Time.current.strftime("%d %B %Y %I:%M %p") %></div>

</div>

<p>If you believe this was a mistake, please contact support.</p>

<% end %>
